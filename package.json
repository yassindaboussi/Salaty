{
  "name": "salaty",
  "version": "1.1.5",
  "description": "Salaty Time Islamic Prayer Times Desktop App",
  "main": "src/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-noble-hashes-esm.js",
    "build:renderer": "node scripts/build-renderer.js",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "predev": "npm run build:renderer",
    "dev": "electron . --enable-logging",
    "prebuild": "npm run build:renderer",
    "build": "electron-builder",
    "prebuild:linux": "npm run build:renderer",
    "build:linux": "electron-builder --linux",
    "predist": "npm run build:renderer",
    "dist": "electron-builder --publish=never",
    "clean": "rm -rf dist",
    "lint": "eslint src/ scripts/ --max-warnings 0 && npm run lint:css && npm run lint:locales && npm run lint:csp && npm run format:check",
    "format": "prettier --write \"src/**/*.{js,html,css,json}\" \"scripts/**/*.js\"",
    "lint:main": "eslint src/main/",
    "lint:renderer": "eslint src/renderer/",
    "lint:css": "stylelint \"src/renderer/css/**/*.css\" --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{js,html,css,json}\" \"scripts/**/*.js\"",
    "lint:locales": "node scripts/check-locales.js",
    "lint:csp": "node scripts/check-csp.js",
    "audit:check": "node scripts/check-audit.js"
  },
  "author": {
    "name": "Yassin Daboussi",
    "email": "salatytime@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "prettier": "^3.6.2",
    "salaty-qibla-map": "^1.0.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tom-select": "^2.4.3"
  },
  "build": {
    "appId": "com.yassindaboussi.salaty",
    "productName": "Salaty Time",
    "directories": {
      "output": "dist",
      "buildResources": "src/assets"
    },
    "files": [
      "src/**/*",
      "package.json",
      "settings.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "yassindaboussi",
        "repo": "Salaty"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/app_icon.ico",
      "artifactName": "Salaty-Time-Setup.exe"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "icon": "src/assets/icons/app_icon_512.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "icon": "src/assets/icons/app_icon.png",
      "category": "Utility",
      "maintainer": "Yassin Daboussi <dev@salaty.app>",
      "artifactName": "${productName}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "src/assets/installer.nsh"
    },
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    }
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "^6.7.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "global-agent": "^4.1.3"
  }
}
