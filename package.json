{
  "name": "salaty",
  "version": "1.1.6",
  "description": "Salaty Time Islamic Prayer Times Desktop App",
  "homepage": "https://github.com/yassindaboussi/Salaty",
  "repository": {
    "type": "git",
    "url": "https://github.com/yassindaboussi/Salaty.git"
  },
  "feedbackAccessKey": "3d932ba5-2d84-43fa-9234-127772d3517b",
  "main": "src/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-noble-hashes-esm.js",
    "build:renderer": "node scripts/build-renderer.js",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "predev": "npm run build:renderer",
    "dev": "electron . --enable-logging",
    "prebuild": "npm run build:renderer",
    "build": "electron-builder",
    "prebuild:linux": "npm run build:renderer",
    "build:linux": "electron-builder --linux",
    "predist": "npm run build:renderer",
    "dist": "electron-builder --publish=never",
    "clean": "rm -rf dist",
    "lint": "eslint src/ scripts/ --max-warnings 0 && npm run lint:types && npm run lint:architecture && npm run lint:css && npm run lint:locales && npm run lint:csp && npm run format:check",
    "format": "prettier --write \"src/**/*.{js,ts,html,css,json}\" \"scripts/**/*.js\" \"tsconfig*.json\"",
    "lint:main": "eslint src/main/",
    "lint:renderer": "eslint src/renderer/",
    "lint:css": "stylelint \"src/renderer/css/**/*.css\" --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{js,ts,html,css,json}\" \"scripts/**/*.js\" \"tsconfig*.json\"",
    "lint:locales": "node scripts/check-locales.js",
    "lint:csp": "node scripts/check-csp.js",
    "lint:types": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "lint:architecture": "node scripts/check-architecture.js",
    "audit:check": "node scripts/check-audit.js",
    "assets:store": "electron scripts/make-store-assets.js"
  },
  "author": {
    "name": "Yassin Daboussi",
    "email": "salatytime@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "salaty-qibla-map": "^1.0.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tom-select": "^2.4.3",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.yassindaboussi.salaty",
    "productName": "Salaty Time",
    "directories": {
      "output": "dist",
      "buildResources": "src/assets"
    },
    "files": [
      "src/**/*",
      "!src/renderer/js/**",
      "!src/assets/appx/**",
      "!**/tsconfig.json",
      "package.json",
      "settings.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "yassindaboussi",
        "repo": "Salaty"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/app_icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "src/assets/icons/app_icon_512.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Salaty-Time-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/icons/app_icon.png",
      "category": "Utility",
      "maintainer": "Yassin Daboussi <dev@salaty.app>",
      "artifactName": "Salaty-Time-linux-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Salaty-Time-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "src/assets/installer.nsh"
    },
    "appx": {
      "artifactName": "Salaty-Time-${version}-store.${ext}",
      "applicationId": "SalatyTime",
      "displayName": "Salaty Time",
      "backgroundColor": "#060c18",
      "languages": [
        "en-US",
        "ar",
        "fr"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "addAutoLaunchExtension": true,
      "showNameOnTiles": true
    },
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    }
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "^6.7.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "global-agent": "^4.1.3"
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": false
  }
}
